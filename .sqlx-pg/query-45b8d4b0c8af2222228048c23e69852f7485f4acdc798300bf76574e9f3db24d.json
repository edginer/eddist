  "query": "\n            SELECT nw.id AS \"id: Uuid\", nw.name, nw.word, nw.created_at, nw.updated_at\n            FROM ng_words AS nw\n            JOIN boards_ng_words AS bnw ON nw.id = bnw.ng_word_id\n            JOIN boards AS b ON bnw.board_id = b.id\n            WHERE b.board_key = $1\n            ",
