  "query": "\n            SELECT title, thread_number, id AS \"id: Uuid\", last_modified_at\n            FROM threads\n            WHERE board_id = (SELECT id FROM boards WHERE board_key = $1)\n            AND active = FALSE\n            AND archived = TRUE\n            AND archive_converted = $2\n            ",
